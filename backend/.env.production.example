# Plantilla de variables de entorno para el despliegue en el VPS de producción.
# Copiar como `.env` en el servidor y completar con los valores reales —
# nunca commitear el `.env` real ni pegar credenciales en el repositorio.
# Ningún valor de este archivo es real: son placeholders para completar.

NODE_ENV=production
PORT=3000

# Base de Datos MySQL de producción
DB_HOST=127.0.0.1
DB_USER=cel_shop_center_prod
DB_PASSWORD=
DB_NAME=cel_shop_center_db

# Autenticación (JWT) — generar un secreto propio y aleatorio, distinto al
# usado en desarrollo (ej: openssl rand -hex 32)
JWT_SECRET=

# MercadoPago (https://www.mercadopago.com.ar/developers/panel)
# Solo el access token de PRODUCCIÓN: no se incluye MP_ACCESS_TOKEN_TEST acá
# a propósito, ese es exclusivo del entorno de desarrollo con Sandbox.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# WhatsApp API (Cloud API oficial de Meta)
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# Nombres de las plantillas (aprobadas en Meta Business Manager) que usan los
# crons de cobranza para mensajes fuera de la ventana de 24hs de atención
WHATSAPP_TEMPLATE_CUOTA=recordatorio_cuota
WHATSAPP_TEMPLATE_PEDIDO_VENCIDO=recordatorio_pedido_vencido
WHATSAPP_TEMPLATE_LANG=es_AR

# Andreani (proveedor logístico) — integración en preparación, el servicio
# funciona en modo simulado hasta que estén las credenciales reales.
ANDREANI_USUARIO=
ANDREANI_CONTRASENA=
ANDREANI_CLIENTE_ID=

# Email transaccional (Nodemailer con SMTP genérico: SendGrid, Resend,
# Amazon SES vía SMTP, o un dominio propio con contraseña de aplicación)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Cel Shop Center <no-reply@celshopcenter.com.ar>

# URLs del frontend en producción (redirecciones post-pago) —
# reemplazar por el dominio real
FRONTEND_URL=https://www.celshopcenter.com.ar
FRONTEND_SUCCESS_URL=https://www.celshopcenter.com.ar/pago-exitoso
FRONTEND_FAILURE_URL=https://www.celshopcenter.com.ar/pago-fallido
FRONTEND_PENDING_URL=https://www.celshopcenter.com.ar/pago-pendiente

# CORS: orígenes permitidos separados por coma. Incluir dominio raíz y www
# si corresponde (ej. "https://celshopcenter.com.ar,https://www.celshopcenter.com.ar").
# Cualquier origen fuera de esta lista es rechazado.
ALLOWED_ORIGINS=https://www.celshopcenter.com.ar

# Usadas ÚNICAMENTE por `npm run db:clean` (backend/scripts/cleanDb.js), el
# seeder que vacía la base y crea el único admin antes del primer deploy.
# No se usan en el arranque normal del servidor -- no hace falta dejarlas
# cargadas en el .env real del servidor después de correr el script una vez.
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_NOMBRE=
