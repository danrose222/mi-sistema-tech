# Configuración del Servidor
PORT=3000

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=cel_shop_center_db

# Autenticación (JWT) — generar un secreto propio y aleatorio (ej: openssl rand -hex 32)
JWT_SECRET=

# MercadoPago (https://www.mercadopago.com.ar/developers/panel)
# MP_ACCESS_TOKEN_TEST: credencial de Sandbox (TEST-...) para desarrollo local
# con ngrok, tiene prioridad sobre MP_ACCESS_TOKEN si ambas están definidas.
MP_ACCESS_TOKEN=
MP_ACCESS_TOKEN_TEST=
MP_WEBHOOK_SECRET=

# WhatsApp API (Cloud API oficial de Meta)
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# Nombres de las plantillas (aprobadas en Meta Business Manager) que usan los
# crons de cobranza para mensajes fuera de la ventana de 24hs de atención
WHATSAPP_TEMPLATE_CUOTA=recordatorio_cuota
WHATSAPP_TEMPLATE_PEDIDO_VENCIDO=recordatorio_pedido_vencido
WHATSAPP_TEMPLATE_LANG=es_AR

# Andreani (proveedor logístico) — integración en preparación, el servicio
# funciona en modo simulado hasta que estén las credenciales reales.
ANDREANI_USUARIO=
ANDREANI_CONTRASENA=
ANDREANI_CLIENTE_ID=

# Email transaccional (Nodemailer con SMTP genérico: sirve para Gmail con
# contraseña de aplicación, SendGrid, Resend, Amazon SES vía SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Cel Shop Center <no-reply@celshopcenter.com.ar>

# URLs del frontend (redirecciones post-pago)
FRONTEND_URL=http://localhost:4200
FRONTEND_SUCCESS_URL=http://localhost:4200/pago-exitoso
FRONTEND_FAILURE_URL=http://localhost:4200/pago-fallido
FRONTEND_PENDING_URL=http://localhost:4200/pago-pendiente

# CORS: orígenes permitidos, separados por coma (sin espacios extra necesarios,
# se recortan solos). Si no se define, se usa FRONTEND_URL como único origen.
ALLOWED_ORIGINS=http://localhost:4200
