# Configuración del Servidor
PORT=3000

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=cel_shop_center_db

# Autenticación (JWT) — generar un secreto propio y aleatorio (ej: openssl rand -hex 32)
JWT_SECRET=

# MercadoPago (https://www.mercadopago.com.ar/developers/panel)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# WhatsApp API
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# URLs del frontend (CORS + redirecciones post-pago)
FRONTEND_URL=http://localhost:4200
FRONTEND_SUCCESS_URL=http://localhost:4200/pago-exitoso
FRONTEND_FAILURE_URL=http://localhost:4200/pago-fallido
FRONTEND_PENDING_URL=http://localhost:4200/pago-pendiente
